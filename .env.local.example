# 既存 Supabase プロジェクト「Zaiko STARTER」の接続情報
# Dashboard → Settings → API から取得してください

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# サーバー専用（NEXT_PUBLIC_ を付けないこと）
# 入出庫 API Route が RPC 呼び出しに使用
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ログイン機能（現在未使用）
# APP_AUTH_PASSWORD=your_app_password
# SESSION_SECRET=your_random_secret_at_least_16_chars
