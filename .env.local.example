# 既存 Supabase プロジェクト「Zaiko STARTER」の接続情報
# Dashboard → Settings → API から取得してください

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# サーバー専用（NEXT_PUBLIC_ を付けないこと）
# 入出庫 API Route が RPC 呼び出しに使用
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# KEYENCE BT-600 ローカル連携ソフト（Windows PC 上）の URL。秘密情報ではない。
# 未設定なら http://127.0.0.1:8765 を使う
# NEXT_PUBLIC_KEYENCE_BRIDGE_URL=http://127.0.0.1:8765

# ログイン機能（現在未使用）
# APP_AUTH_PASSWORD=your_app_password
# SESSION_SECRET=your_random_secret_at_least_16_chars
